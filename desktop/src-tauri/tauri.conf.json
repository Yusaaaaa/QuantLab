{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantLab",
  "version": "2026.10.22",
  "identifier": "com.quantlab.research",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuantLab \u00b7 Research Terminal",
        "width": 1480,
        "height": 980,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Finance",
    "shortDescription": "Local quantitative research workbench"
  }
}
